    "appforge-confirm": "bin/confirm.js",
    "appforge-plan": "bin/plan.js",
    "appforge-generate": "bin/generate.js"
  },
  "scripts": {
    "test": "node --test \"test/*.test.js\"",
    "research": "node bin/research.js",
    "confirm": "node bin/confirm.js",
    "plan": "node bin/plan.js",
    "generate": "node bin/generate.js",
    "serve": "node bin/serve.js"
  },
  "devDependencies": {
    "ajv": "^8.20.0"
  }
